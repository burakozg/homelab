# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# The vault's own CouchDB — the same one Self-hosted LiveSync replicates
# against, and the same instance every app's own VAULT_* variables point at
# (see e.g. clippings-topics/.env). Reused here, not re-issued, because it's
# the same account.

VAULT_COUCHDB_URL=http://vault-couch.example.local:5984
VAULT_DB=the_brain
VAULT_USER=admin
VAULT_COUCHDB_PASSWORD=

# Where backup-vault.sh writes dumps on this machine. Deliberately NOT inside
# the iCloud-synced Obsidian vault folder — this is an archive, not a live
# synced folder, and mixing the two would risk exactly the kind of sync
# confusion this backup exists to protect against.
VAULT_BACKUP_DIR=${HOME}/Backups/vault-couchdb
