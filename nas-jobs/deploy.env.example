# Deploy-time values for ./deploy. Copy to .deploy.env, which is gitignored.
# Real topology — hosts, ports, paths — belongs only in that file.

NAS_SSH=deploy@nas.local
NAS_SSH_PORT=44
# Working directory on the NAS: data/ (snapshots, state), site/ (the status page),
# jobs.env and the compose file live here.
NAS_APP_DIR=/share/Container/homelab-jobs
NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
NAS_PLATFORM=linux/amd64
NAS_DOCKER_CONFIG=/tmp/.docker-deploy

# Where the vault dumps land. Pick a path on a DIFFERENT NAS volume than the live
# CouchDB (compare `df` for the two), or a dump shares a disk with what it backs up.
JOBS_BACKUP_DIR=/share/CACHEDEV3_DATA/example/homelab-backups/vault-couchdb
