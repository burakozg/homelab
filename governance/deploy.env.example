# Deploy-time values for ./deploy. Copy to .deploy.env, which is gitignored.
# Real topology — hosts, ports, paths — belongs only in that file.

NAS_SSH=deploy@nas.local
NAS_SSH_PORT=44
NAS_APP_DIR=/share/Container/governance
NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
NAS_PLATFORM=linux/amd64
NAS_DOCKER_CONFIG=/tmp/.docker-deploy

# The hostname Traefik routes to this site (only used by `./deploy traefik` to
# print the routes to add, and by `check` to confirm the login gate is in place).
GOVERNANCE_HOST=governance.example.lan
# Traefik's own LAN address, for `check`'s end-to-end gate test.
TRAEFIK_LAN_IP=10.0.0.2

# Where the homelab-jobs container writes the status page (nas-jobs/.deploy.env's
# NAS_APP_DIR). Mounted read-only into the web server.
NAS_JOBS_DIR=/share/Container/homelab-jobs
